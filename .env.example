# ─── Application ─────────────────────────────────────────────────────────────
# Node environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# ─── PostgreSQL (primary database) ───────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=postgres
DB_PASSWORD=postgres

# ─── PostgreSQL (test database) ──────────────────────────────────────────────
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secret used to sign access tokens — keep this long and random
JWT_SECRET=change_me_to_a_long_random_string

# Access token expiry (ms/vercel-ms string, e.g. "15m", "1h")
JWT_EXPIRES_IN=15m

# Secret used to sign refresh tokens
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Refresh token expiry
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ──────────────────────────────────────────────────────────────────
# Number of salt rounds for bcrypt password hashing
BCRYPT_ROUNDS=10

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200

# Optional: Elasticsearch cloud API key
# ELASTICSEARCH_API_KEY=

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001

# ─── Logging ─────────────────────────────────────────────────────────────────
# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Directory for log files (relative to project root)
LOG_DIR=logs
